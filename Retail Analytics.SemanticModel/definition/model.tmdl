model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["tblDimCustomer","tblDimCustomerType","tblDimDate","tblDimDevice","tblDimLoyaltyStatus","tblDimOrderType","tblDimPaymentMethod","tblDimProduct","tblDimPromotion","tblDimSalesRep","tblDimStore","tblFactSales"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table tblDimCustomer
ref table tblDimCustomerType
ref table tblDimDate
ref table tblDimDevice
ref table tblDimLoyaltyStatus
ref table tblDimOrderType
ref table tblDimPaymentMethod
ref table tblDimProduct
ref table tblDimPromotion
ref table tblDimSalesRep
ref table tblDimStore
ref table tblFactSales
ref table '_Sales Measures'
ref table '_Geography Measures'
ref table '_Time Intelligence Measures'
ref table '_Customer & Marketing Measures'
ref table '_Operations & Returns Measures'

ref cultureInfo en-US

